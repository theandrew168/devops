{{ ansible_managed | comment }}

[Unit]
Description=postgres_exporter
Documentation=https://github.com/prometheus-community/postgres_exporter
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=simple
User=postgres_exporter
Group=postgres_exporter
Environment="DATA_SOURCE_URI={{ postgres_exporter_database_uri }}"
Environment="DATA_SOURCE_USER={{ postgres_exporter_database_username }}"
Environment="DATA_SOURCE_PASS_FILE=/etc/postgres_exporter_password"
ExecStart=postgres_exporter --web.listen-address localhost:9187

[Install]
WantedBy=multi-user.target
